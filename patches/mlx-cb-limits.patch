+++ b/mlx/backend/metal/device.h
@@ -2,6 +2,8 @@
 
 #pragma once
 
+#include <atomic>
+
 #include <Metal/Metal.hpp>
 #include <functional>
 #include <mutex>
@@ -162,7 +164,21 @@ class MLX_API Device {
     return arch_gen_;
   }
   std::tuple<int, int> get_max_ops_mb_per_buffer() const {
-    return std::make_tuple(max_ops_per_buffer_, max_mb_per_buffer_);
+    return std::make_tuple(
+        max_ops_per_buffer_.load(std::memory_order_relaxed),
+        max_mb_per_buffer_.load(std::memory_order_relaxed));
+  }
+  // The limits a command buffer is committed at (`metal::set_command_buffer_limits`);
+  // a value <= 0 keeps that limit. Returns the previous limits.
+  std::tuple<int, int> set_max_ops_mb_per_buffer(int max_ops, int max_mb) {
+    auto prev = get_max_ops_mb_per_buffer();
+    if (max_ops > 0) {
+      max_ops_per_buffer_.store(max_ops, std::memory_order_relaxed);
+    }
+    if (max_mb > 0) {
+      max_mb_per_buffer_.store(max_mb, std::memory_order_relaxed);
+    }
+    return prev;
   }
 
