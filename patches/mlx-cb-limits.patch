       library_kernels_;
   std::string arch_;
   int arch_gen_;
-  int max_ops_per_buffer_;
-  int max_mb_per_buffer_;
+  std::atomic<int> max_ops_per_buffer_;
+  std::atomic<int> max_mb_per_buffer_;
 };
 
