diff -ru a/mlx/backend/metal/allocator.cpp b/mlx/backend/metal/allocator.cpp
--- a/mlx/backend/metal/allocator.cpp	2026-09-28 08:37:06
+++ b/mlx/backend/metal/allocator.cpp	2026-10-11 03:22:52
@@ -124,6 +124,18 @@
   if (size > vm_page_size) {
     size = vm_page_size * ((size + vm_page_size - 1) / vm_page_size);
   }
+  // Size classes (set_alloc_size_classes): at most 12.5 % padding, the same
+  // class for requests of nearly the same size, so a cached buffer of the
+  // class is reused.
+  if (size_classes_.load(std::memory_order_relaxed) &&
+      size >= (size_t(1) << 20)) {
+    size_t p = size_t(1) << (63 - __builtin_clzll(size));
+    size_t step = std::max<size_t>(p / 8, vm_page_size);
+    size_t classed = step * ((size + step - 1) / step);
+    if (classed <= device_->maxBufferLength()) {
+      size = classed;
+    }
+  }
 
   // Try the cache
   std::unique_lock lk(mutex_);
@@ -244,6 +256,9 @@
 
 size_t set_cache_limit(size_t limit) {
   return metal::allocator().set_cache_limit(limit);
+}
+bool set_alloc_size_classes(bool on) {
+  return metal::allocator().set_size_classes(on);
 }
 size_t set_memory_limit(size_t limit) {
   return metal::allocator().set_memory_limit(limit);
