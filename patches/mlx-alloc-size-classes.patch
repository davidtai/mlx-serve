diff -ru a/mlx/memory.h b/mlx/memory.h
--- a/mlx/memory.h	2026-09-28 08:37:06
+++ b/mlx/memory.h	2026-10-11 03:22:52
@@ -90,4 +90,13 @@
  * */
 MLX_API size_t set_wired_limit(size_t limit);
 
+/* Round each allocation of 1 MB or more up to one of 8 size classes per power
+ * of two while on (at most 12.5 % more than asked), so requests of nearly the
+ * same size reuse one cached buffer. Off by default. Only the Metal allocator
+ * rounds; elsewhere this is a no-op.
+ *
+ * Returns the previous setting.
+ * */
+MLX_API bool set_alloc_size_classes(bool on);
+
